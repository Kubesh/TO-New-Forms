# Neon Postgres connection string.
# Get this from your Neon project dashboard (Connection Details).
# Use the psycopg (v3) driver scheme.
# Example: postgresql+psycopg://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Google Sheets customer sync (optional - creating/editing customers works
# fine without these, the sync is just skipped). See the Sheets setup guide
# for how to create the service account and share the spreadsheet with it.
# Path to the service account JSON key, relative to the repo root.
GOOGLE_SHEETS_CREDENTIALS_FILE=service-account.json
# The spreadsheet's ID, from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# The tab within that spreadsheet to sync customers into.
GOOGLE_SHEETS_TAB_NAME=streamlit_data
