# Neon Postgres connection string.
# Get this from your Neon project dashboard (Connection Details).
# Use the psycopg (v3) driver scheme.
# Example: postgresql+psycopg://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Customers sheet ---
# Google Sheets customer sync (optional - creating/editing customers works
# fine without these, the sync is just skipped). See the Sheets setup guide
# for how to create the service account and share the spreadsheet with it.
# Path to the service account JSON key, relative to the repo root.
GOOGLE_SHEETS_CREDENTIALS_FILE=service-account.json
# The spreadsheet's ID, from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# The tab within that spreadsheet to sync customers into.
GOOGLE_SHEETS_TAB_NAME=streamlit_data

# ShipStation (classic API) - "Send to ShipStation" on the PO detail page and
# scripts/shipstation_sync.py. Get the key/secret from ShipStation under
# Settings > Account > API Settings. Without them the button shows a
# "not configured" message instead of failing.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Optional. Which ShipStation store (sales channel) new orders are filed under;
# leave blank to let ShipStation use its default.
SHIPSTATION_STORE_ID=

# --- PO sheet ---
# A second, separate spreadsheet that gets one row per purchase order line item
# (Ship Date, PO Number, Store Key, SKU, Quantity, Order Date, Due Date),
# updated whenever a PO is created, edited, or shipped. Entirely separate from
# the customers sheet above; leave GOOGLE_SHEETS_PO_SPREADSHEET_ID blank to
# turn it off. Share the spreadsheet with the same service account as above
# (Editor access). To load existing POs: python scripts/sync_pos_to_sheet.py
# The spreadsheet's ID, from its URL.
GOOGLE_SHEETS_PO_SPREADSHEET_ID=
# The tab to write to; created automatically if it doesn't exist.
GOOGLE_SHEETS_PO_TAB_NAME=po_data
# Optional: only if this sheet needs a different service account than the
# customers sheet. Defaults to GOOGLE_SHEETS_CREDENTIALS_FILE.
GOOGLE_SHEETS_PO_CREDENTIALS_FILE=

# QuickBooks Online (Intuit) - connects the app to a QuickBooks company.
# Keys come from developer.intuit.com > My Apps > your app > Keys & credentials.
# The Development keys work only with sandbox companies; the Production keys
# with the real one. Connect once with: python scripts/qbo_connect.py
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" (default) or "production" - must match which keys you entered.
QBO_ENVIRONMENT=sandbox
# Must be registered under the app's Redirect URIs on developer.intuit.com.
QBO_REDIRECT_URI=http://localhost:8000/callback
